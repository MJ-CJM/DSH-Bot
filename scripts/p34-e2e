#!/usr/bin/env node
/** Final release bytes, isolated native Host/Gateway, loopback models, separate browser verdict. */
import assert from 'node:assert/strict';
import { spawn } from 'node:child_process';
import { mkdir, readFile, readdir, writeFile } from 'node:fs/promises';
import { dirname, relative, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { setTimeout as delay } from 'node:timers/promises';
import { auditArtifact, auditInstalled, command, sha256 } from './p34-artifact.mjs';
import { checkMarket } from './p34-market.mjs';
import { checkUpgrade } from './p34-upgrade.mjs';

const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
assert.equal(process.cwd(), root, 'Run from repository root');
const home = resolve(root, '.dsh-dev');
assert.equal(process.env.DSH_HOME, home, 'DSH_HOME="$PWD/.dsh-dev" required');
const runDir = resolve(home, 'p34-u12-13', `${Date.now()}-${process.pid}`);
await mkdir(runDir, { recursive: true });
await writeFile(resolve(home, 'p34-u12-13/latest-run.txt'), `${runDir}\n`);
const env = Object.fromEntries(['PATH', 'HOME', 'USER', 'SHELL'].flatMap(key => process.env[key] ? [[key, process.env[key]]] : []));
Object.assign(env, { DSH_HOME: home, DSH_TELEMETRY_DISABLED: '1',
  TMPDIR: resolve(runDir, 'tmp'), XDG_STATE_HOME: resolve(runDir, 'state'),
  pnpm_config_store_dir: resolve(home, 'pnpm-store'), pnpm_config_cache_dir: resolve(home, 'pnpm-cache') });
await mkdir(env.TMPDIR, { recursive: true });
const version = JSON.parse(await readFile(resolve(root, 'packages/dsh-bot/package.json'))).version;
const artifact = resolve(root, `dist/dsh-bot-${version}.tgz`);
const summary = { status: 'FAIL', runDir, realModelRequests: 0, modelRequests: 0,
  scope: 'One exact tgz; independent fresh profiles for domain fault scenarios; browser status separate.',
  checks: [], scenarios: [], browser: { status: 'FAIL', reason: process.argv.includes('--host-only') ? 'NOT_RUN; screenshots delegated to orchestrator by R-review-r3' : 'not run' },
  imTransport: { status: 'FAIL', reason: 'U01 consumer gate unverified; safe disabled state tested.' },
  desktop: { status: 'FAIL', reason: 'NOT_RUN; no public OS notification API or Desktop mutation authorized.' } };
const save = () => writeFile(resolve(runDir, 'summary.json'), `${JSON.stringify(summary, null, 2)}\n`);
const redact = value => String(value).replace(/([?&]token=)[^\s&"'<>]+/gi, '$1[redacted]');
const check = async (id, fn) => {
  try { const detail = await fn(); summary.checks.push({ id, status: 'PASS', ...detail }); console.log(`PASS ${id}`); }
  catch (error) { summary.checks.push({ id, status: 'FAIL', reason: redact(error) }); console.log(`FAIL ${id}: ${redact(error)}`); }
  await save();
};
async function execute(bin, args, label, extra = {}) {
  const execution = await command(bin, args, { cwd: root, env: { ...env, ...extra } });
  await writeFile(resolve(runDir, `${label}.log`), execution.output.replace(/([?&]token=)[^\s&"'<>]+/gi, '$1[redacted]'));
  assert.equal(execution.code, 0, `See ${label}.log`);
  return execution;
}
let audit;
await check('frozen_install', async () => { await execute(resolve(root, 'scripts/pnpm'), ['install', '--frozen-lockfile'], 'install'); });
await check('build_test_strict_lint', async () => { await execute(resolve(root, 'scripts/pnpm'), ['check'], 'check'); await execute(resolve(root, 'scripts/pnpm'), ['-C', 'spikes/p34', 'build'], 'build-probe-support'); });
await check('pack_and_byte_audit', async () => {
  await execute(resolve(root, 'scripts/pnpm'), ['pack:plugin'], 'pack');
  audit = await auditArtifact(root, artifact, runDir);
  await writeFile(resolve(root, 'dist/artifact-manifest.json'), `${JSON.stringify(audit, (key, value) => key === 'packedRoot' ? undefined : value, 2)}\n`);
  await writeFile(resolve(root, `dist/dsh-bot-${version}.tgz.sha256`), `${audit.sha256}  dsh-bot-${version}.tgz\n`);
  return { sha256: audit.sha256, files: audit.files.length };
});
await check('market_parser_and_mock_installer', async () => {
  const result = await checkMarket(root, resolve(runDir, 'market'), env);
  assert.equal(result.status, 'PASS');
  return { evidence: 'market/result.json', gitFetch: result.gitFetch };
});
const scenarios = [
  ['connectors-notifications', ['scripts/p34-runtime.mjs'], 'summary.json', 'PASS'],
  ['im-gate-team', ['scripts/p34-collaboration-runtime.mjs'], 'summary.json', 'PASS'],
  ['groups', ['scripts/p34-groups-runtime.mjs'], 'summary.json', 'PASS'],
  ['memory-transfer', ['scripts/p34-memory-runtime.mjs'], 'summary.json', 'PASS'],
  ['native-schedule', ['scripts/screenshot.mjs', '--v022-host-only'], 'summary.json', 'HOST_ONLY_PASS'],
  ['native-delegate', ['packages/dsh-bot/tests/delegate-profile.mts'], 'result.json', 'PASS'],
];
for (const [name, args, file, expected] of scenarios) await check(name, async () => {
  assert.ok(audit, 'Artifact audit must pass first');
  const outputDir = resolve(runDir, name);
  await execute(process.execPath, args.map((arg, i) => i ? arg : resolve(root, arg)), name,
    { DSH_BOT_E2E_DIR: outputDir, DSH_BOT_E2E_PACKAGE: artifact });
  const result = JSON.parse(await readFile(resolve(outputDir, file)));
  assert.equal(result.status, expected); assert.equal(result.realModelRequests, 0);
  const installed = await auditInstalled(home, result.profile, audit);
  await writeFile(resolve(outputDir, 'release-package-audit.json'), `${JSON.stringify(installed, null, 2)}\n`);
  const count = Array.isArray(result.mockRequests) ? result.mockRequests.length : result.modelRequests ?? result.mockRequests ?? 0;
  summary.modelRequests += count;
  summary.scenarios.push({ name, profile: result.profile, status: 'PASS', modelRequests: count,
    rootModelRequests: result.rootModelRequests, browser: result.browser, evidence: `${name}/${file}`, installed });
  return { evidence: `${name}/${file}`, modelRequests: count };
});
await check('cli_remove_reinstall_persistent_data_and_host', async () => {
  const scenario = summary.scenarios.find(s => s.name === 'connectors-notifications');
  assert.ok(scenario); const { profile } = scenario;
  const profileDir = resolve(home, 'profiles', profile);
  const storageDir = resolve(runDir, 'connectors-notifications/storages');
  async function snapshot(dir) {
    const rows = [];
    for (const entry of await readdir(dir, { withFileTypes: true })) {
      const path = resolve(dir, entry.name);
      if (entry.isDirectory()) rows.push(...await snapshot(path));
      else rows.push({ file: relative(storageDir, path), sha256: sha256(await readFile(path)) });
    }
    return rows.sort((a, b) => a.file.localeCompare(b.file));
  }
  const before = await snapshot(storageDir);
  await execute(resolve(root, 'scripts/dsh'), ['plugin', '--profile', profile, 'remove', 'dsh-bot'], 'remove');
  const removed = JSON.parse(await readFile(resolve(profileDir, 'package.json')));
  assert.ok(!removed.dependencies?.['dsh-bot']); assert.ok(!removed.dsh.profile.bundles.includes('dsh-bot'));
  assert.deepEqual(await snapshot(storageDir), before);
  await execute(resolve(root, 'scripts/dsh'), ['plugin', '--profile', profile, 'add', artifact], 'reinstall');
  await auditInstalled(home, profile, audit); assert.deepEqual(await snapshot(storageDir), before);
  const patch = [
    '- id: storage-json', '  config:', `    root: ${JSON.stringify(storageDir)}`,
    '- id: session-persistence-jsonl', '  config:', `    root: ${JSON.stringify(resolve(runDir, 'connectors-notifications/sessions'))}`,
    '- id: credentials-local', '  config:', `    path: ${JSON.stringify(resolve(runDir, 'synthetic-credentials.yaml'))}`, '    watch: false',
    '- id: dsh-bot', '  config:', '    seedExamples: false', `    dataDir: ${JSON.stringify(resolve(runDir, 'connectors-notifications/bots-data'))}`,
    ...['llm-deepseek', 'llm-deepseek-account', 'llm-pi-ai', 'session-title-llm', 'session-log-deepseek', 'session-telemetry-otel', 'desktop-product-telemetry'].flatMap(id => [`- id: ${id}`, '  disabled: true']),
    '- insert:', '    - id: release-reinstall-probe', `      name: ${JSON.stringify(resolve(root, 'packages/dsh-bot/tests/release-profile-host.mjs'))}`,
    '      config:', `        outputDir: ${JSON.stringify(runDir)}`,
  ];
  await writeFile(resolve(profileDir, 'cordis.patch.yml'), `${patch.join('\n')}\n`);
  const child = spawn(resolve(root, 'scripts/dsh'), ['--profile', profile, '--no-open', '--host', '127.0.0.1', '--port', '0'],
    { cwd: root, env: { ...env, DSH_AGENTS_HOME: resolve(runDir, 'reinstall-agents') }, stdio: ['ignore', 'pipe', 'pipe'] });
  let output = '', closed = false;
  for (const stream of [child.stdout, child.stderr]) stream.on('data', chunk => { output += chunk; });
  const done = new Promise((accept, reject) => { child.once('error', reject); child.once('close', code => { closed = true; accept(code); }); });
  const kill = setTimeout(() => child.kill('SIGKILL'), 120000);
  try {
    const until = Date.now() + 90000;
    while (!closed && Date.now() < until && !/P34_RELEASE_REINSTALL_(READY|FAILED)/.test(output)) await delay(100);
    assert.match(output, /P34_RELEASE_REINSTALL_READY/);
  } finally {
    child.kill('SIGTERM');
    const shutdown = setTimeout(() => child.kill('SIGKILL'), 10000);
    const code = await done; clearTimeout(shutdown); clearTimeout(kill);
    await writeFile(resolve(runDir, 'reinstall-host.log'), output.replace(/([?&]token=)[^\s&"'<>]+/gi, '$1[redacted]'));
    assert.equal(code, 0);
  }
  return { evidence: 'reinstalled-host.json', storedFilesPreserved: before.length };
});
for (const oldVersion of ['0.2.2', '0.3.0']) await check(`upgrade_${oldVersion}_to_${version}`, async () => {
  assert.ok(audit);
  const dir = `upgrade-${oldVersion}`;
  await checkUpgrade(root, resolve(runDir, dir), env, artifact, audit, oldVersion);
  return { evidence: `${dir}/result.json` };
});
if (!process.argv.includes('--host-only')) await check('screenshot_fixture_and_matrix', async () => {
  assert.ok(audit);
  const execution = await command(process.execPath, [resolve(root, 'scripts/screenshot.mjs'), '--v03'],
    { cwd: root, env: { ...env, DSH_BOT_E2E_PACKAGE: artifact } });
  await writeFile(resolve(runDir, 'screenshots.log'), execution.output);
  const dir = (await readFile(resolve(home, 'p34-u12-13/latest-screenshots.txt'), 'utf8')).trim();
  const result = JSON.parse(await readFile(resolve(dir, 'result.json')));
  summary.browser = { status: result.status, fixtureStatus: result.fixtureStatus, outputDir: relative(root, dir),
    targets: result.matrix.length, passed: result.matrix.filter(s => s.status === 'PASS').length,
    narrowChecks: result.narrowChecks, reason: result.failure };
  summary.modelRequests += result.modelRequests;
  assert.equal(result.fixtureStatus, 'PASS'); await auditInstalled(home, result.profile, audit);
  assert.equal(result.status, 'PASS', 'Browser verdict is separate from Host e2e');
});
summary.runtimeStatus = summary.checks.filter(c => c.id !== 'screenshot_fixture_and_matrix').every(c => c.status === 'PASS') ? 'PASS' : 'FAIL';
summary.status = summary.runtimeStatus === 'PASS' && summary.browser.status === 'PASS' && summary.imTransport.status === 'PASS' && summary.desktop.status === 'PASS' ? 'PASS' : 'FAIL';
await save();
console.log(JSON.stringify({ status: summary.status, runtimeStatus: summary.runtimeStatus, browser: summary.browser.status, runDir, modelRequests: summary.modelRequests, realModelRequests: 0 }));
if (summary.status !== 'PASS') process.exitCode = 1;
