{
  "name": "dsh-bot-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "scripts/pnpm -r build",
    "test": "scripts/pnpm -r test",
    "typecheck": "tsc --noEmit -p tsconfig.json && scripts/pnpm -r typecheck",
    "lint": "biome lint .",
    "check": "scripts/pnpm build && scripts/pnpm test && scripts/pnpm typecheck && scripts/pnpm lint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
