{
  "name": "dsh-bot-mode-adapter-probe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "host.mjs",
  "exports": {
    ".": "./host.mjs",
    "./client": "./client.js"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
