{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "datasetVersion",
    "seed",
    "mode",
    "adapterVersion",
    "authorization",
    "source",
    "limits",
    "priceSnapshot",
    "catalog",
    "caseIds",
    "files",
    "outputCeiling"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "datasetVersion": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mode": {
      "enum": [
        "mock",
        "replay"
      ]
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1
    },
    "authorization": {
      "type": "null"
    },
    "source": {
      "const": "synthetic"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calls",
        "input",
        "output",
        "money"
      ],
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "money": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "priceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "model",
        "source",
        "call",
        "input",
        "output"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "const": "synthetic"
        },
        "call": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "evals/manifests/failures.json"
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "caseIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "outputCeiling": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  }
}
