{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "cases",
    "responses"
  ],
  "properties": {
    "source": {
      "const": "synthetic"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "group",
          "catalogCaseId",
          "input",
          "gold"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "memory",
              "workflow",
              "injection"
            ]
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "catalogCaseId": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "from",
                    "to"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "from": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "to": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                },
                "minItems": 1
              },
              "at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "terminal": {
                "type": "string",
                "minLength": 1
              },
              "sideEffects": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "simulateTimeout": {
                "type": "boolean"
              },
              "untrusted": {
                "type": "boolean"
              }
            }
          },
          "gold": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "relevant": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "temporal": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "terminal": {
                "type": "string",
                "minLength": 1
              },
              "sideEffects": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "authorized": {
                "type": "boolean"
              },
              "canary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "response"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "response": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "ok",
                  "error",
                  "timeout"
                ]
              },
              "ranked": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "temporal": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "terminal": {
                "type": "string",
                "minLength": 1
              },
              "sideEffects": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "authorized": {
                "type": "boolean"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      },
      "minItems": 1
    }
  }
}
