{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baselineSha",
    "input",
    "inputSha256",
    "historicalEstimate",
    "actualCandidates",
    "sources",
    "supplementalSources",
    "cases",
    "dispositions",
    "openContracts",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "baselineSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "historicalEstimate": {
      "const": 306
    },
    "actualCandidates": {
      "type": "integer",
      "minimum": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "revision",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 46
    },
    "supplementalSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "revision",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "FIXED",
              "OPEN",
              "SOURCE_ONLY"
            ]
          }
        }
      },
      "minItems": 20
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateId",
          "disposition",
          "caseId",
          "duplicateOf",
          "reason"
        ],
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "case",
              "duplicate",
              "out-of-scope"
            ]
          },
          "caseId": {
            "type": [
              "string",
              "null"
            ]
          },
          "duplicateOf": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "openContracts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
