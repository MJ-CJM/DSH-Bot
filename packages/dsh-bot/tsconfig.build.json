  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "lib",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/index.ts", "src/host/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["src/**/*.test.*", "src/**/*.spec.*"]
}
